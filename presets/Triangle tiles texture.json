{
  "kind": "design-engine/nodes",
  "version": 1,
  "doc": "Triangles pointing up and down, tiled with one web all round. Connect your CAD bodies to the pattern's Body and your part to Offset Body's Body, pick the faces, then show Offset Body. The Number is the height in mm (negative sinks it).",
  "nodes": [
    {
      "id": "pattern",
      "type": "pattern.surface",
      "inputs": {
        "faces": "",
        "shape": "triangle",
        "size": 4.0,
        "layout": "grid",
        "spacing": 5.5,
        "alternate": "checker 180",
        "softness": 0.4,
        "margin": 1.0
      },
      "links": {},
      "pos": [
        0,
        0
      ]
    },
    {
      "id": "amplitude",
      "type": "input.number",
      "inputs": {
        "value": 0.6
      },
      "links": {},
      "pos": [
        0,
        760
      ]
    },
    {
      "id": "height",
      "type": "math.multiply",
      "inputs": {},
      "links": {
        "a": "pattern.out",
        "b": "amplitude.out"
      },
      "pos": [
        360,
        0
      ]
    },
    {
      "id": "textured",
      "type": "implicit.offset",
      "inputs": {},
      "links": {
        "distance": "height.out"
      },
      "pos": [
        680,
        0
      ]
    }
  ]
}