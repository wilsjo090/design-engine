{
  "kind": "design-engine/nodes",
  "version": 1,
  "doc": "Organic Voronoi openings with their edges rounded (0.5 mm) on both sides of the wall. Connect your CAD bodies to the pattern's Body and your part (e.g. Implicit Body from CAD Body) to Boolean Subtract's A, pick the faces, then show the subtract.",
  "nodes": [
    {
      "id": "pattern",
      "type": "pattern.holes",
      "inputs": {
        "faces": "",
        "shape": "voronoi",
        "web": 1.4,
        "corner_radius": 0.6,
        "layout": "staggered",
        "spacing": 7.0,
        "randomness": 0.8,
        "margin": 3.0
      },
      "links": {},
      "pos": [
        0,
        0
      ]
    },
    {
      "id": "cut",
      "type": "implicit.subtract",
      "inputs": {
        "edge": "round",
        "radius": 0.5
      },
      "links": {
        "b": "pattern.out"
      },
      "pos": [
        360,
        0
      ]
    }
  ]
}