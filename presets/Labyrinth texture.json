{
  "kind": "design-engine/nodes",
  "version": 1,
  "doc": "Maze-like raised lines along the contours of noise (the lamp's texture), only on the picked faces. Connect your CAD bodies to Face Mask's Body and your part to Texture's Body, pick the faces, then show Texture. Density sets how many lines, Texture's Height their height.",
  "nodes": [
    {
      "id": "noise",
      "type": "field.noise",
      "inputs": {
        "scale": 30.0,
        "octaves": 2,
        "roughness": 0.5,
        "seed": 1
      },
      "links": {},
      "pos": [
        0,
        0
      ]
    },
    {
      "id": "density",
      "type": "math.multiply",
      "inputs": {
        "b": 60.0
      },
      "links": {
        "a": "noise.out"
      },
      "pos": [
        320,
        0
      ]
    },
    {
      "id": "cos",
      "type": "math.cos",
      "inputs": {},
      "links": {
        "x": "density.out"
      },
      "pos": [
        620,
        0
      ]
    },
    {
      "id": "lines",
      "type": "math.acos",
      "inputs": {},
      "links": {
        "x": "cos.out"
      },
      "pos": [
        900,
        0
      ]
    },
    {
      "id": "faces",
      "type": "field.face_mask",
      "inputs": {
        "faces": "",
        "fade": 1.0,
        "band": 2.0
      },
      "links": {},
      "pos": [
        900,
        260
      ]
    },
    {
      "id": "textured",
      "type": "implicit.texture",
      "inputs": {
        "height": 0.5
      },
      "links": {
        "pattern": "lines.out",
        "fade": "faces.out"
      },
      "pos": [
        2100,
        0
      ]
    }
  ]
}